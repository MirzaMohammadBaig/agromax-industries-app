{
  "name": "agromax-industries-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://agromax.sbs",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
